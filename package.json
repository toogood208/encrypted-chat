{
  "name": "encrypted-chat",
  "private": true,
  "version": "0.1.0",
  "description": "E2EE messaging frontend",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @encrypted-chat/web",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "devDependencies": {
    "@eslint/js": "^9.31.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
